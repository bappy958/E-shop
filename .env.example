# ==========================================
# UNIQUE COLLECTION 4.0 - ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

# Gemini AI API Key (Required for AI Fashion Assistant & Description Generator)
# Automatically injected by AI Studio at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Public Host URL
APP_URL="http://localhost:3000"

# MongoDB Connection String (Production Database)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/unique_collection?retryWrites=true&w=majority"

# JWT Secret Key (Production Auth)
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Cloudinary CDN Configuration (Production Image Storage)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Payment Gateways (bKash / Nagad / SSLCommerz)
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_IS_SANDBOX=true

